VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Dominio institucional real (placeholder ate confirmacao, decisao D5 do plano)
VITE_SITE_URL="https://www.iiv.gov.ao"

# Camada de dados mock (Fase 0-3): true = MSW intercepta chamadas de API
VITE_API_MOCK="true"
# Relativo de propósito: funciona seja qual for a porta que o Vite escolher
# (8080, 8081, ...). Quando o backend Laravel real existir (Fase 4) e estiver
# noutra origem/porta, troca para um URL absoluto (ex: "https://api.iiv.gov.ao").
VITE_API_URL="/api"
