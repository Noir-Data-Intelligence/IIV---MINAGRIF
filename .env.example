# Dominio institucional real (placeholder ate confirmacao, decisao D5 do plano)
VITE_SITE_URL="https://www.iiv.gov.ao"

# Camada de dados mock: true = MSW intercepta chamadas de API. Backend Laravel
# real já existe e está em produção — por omissão liga-se a ele, não ao mock.
VITE_API_MOCK="false"
# URL absoluto: backend está num subdomínio próprio, não no mesmo host do
# frontend (ver docker-compose.production.yml). Para correr contra um Laravel
# local em vez da API real, troca para algo como "http://localhost:8000/api".
VITE_API_URL="https://apiiiv.noirdataintelligence.com/api"

# Porta exposta pelo contentor na VPS
PORT="80"
